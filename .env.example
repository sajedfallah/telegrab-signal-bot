BOT_TOKEN=PASTE_BOT_TOKEN_HERE
ADMIN_IDS=123456789
PUBLIC_CHANNEL_ID=-1001234567890
PUBLIC_CHANNEL_URL=https://t.me/your_public_channel
FREE_CHANNEL_URL=https://t.me/your_free_signal_channel
# Optional for a public channel; required if the free channel is private
FREE_CHANNEL_ID=
# Optional NEXUS forum routing. When both values are set, every logical FREE
# Telegram publication is physically sent to this community chat/topic instead
# of FREE_CHANNEL_ID/FREE_CHANNEL_URL. MT5 continues to send destination=FREE.
FREE_SIGNAL_CHAT_ID=
FREE_SIGNAL_TOPIC_ID=
VIP_CHANNEL_ID=-1009876543210
SUPPORT_USERNAME=https://t.me/your_support
PAYMENT_CARD=0000000000000000
PAYMENT_OWNER=NEXUS
TIMEZONE=Asia/Tehran
REMINDER_DAYS=7,3,1
PLAN_30_PRICE=3.000.000 تومان
PLAN_90_PRICE=8.200.000 تومان
PLAN_180_PRICE=14.000.000 تومان
USDT_WALLET=TCH1fR6p5oSgTCiNkbeZeP4Zfg2sGbmDxc
USDT_NETWORK=TRC20
PLAN_30_USDT=SET_PRICE
PLAN_90_USDT=SET_PRICE
PLAN_180_USDT=SET_PRICE

# Automatic admin reports (Asia/Tehran by default)
REPORTS_ENABLED=true
DAILY_REPORT_TIME=23:59
WEEKLY_REPORT_DAY=FRIDAY
WEEKLY_REPORT_TIME=23:59
# Empty = all ADMIN_IDS
REPORT_RECIPIENT_IDS=
# Send one compact report containing FREE + VIP performance to both signal channels
CHANNEL_REPORTS_ENABLED=true
# Channel flashcards: fa or en
CHANNEL_CONTENT_LANGUAGE=fa
# Optional explicit path to a locally installed B Yekan .ttf/.otf on Windows.
# Example: C:\Windows\Fonts\BYekan.ttf
REPORT_FA_FONT_PATH=
# false prevents old daily/weekly reports from being dumped when the bot restarts
REPORT_CATCHUP_ENABLED=false

# Optional paid Auto-Trade channel; leave empty until configured
AUTOTRADE_CHANNEL_URL=

# Broker-specific Forex pip conventions used in result reports
XAUUSD_PIP_SIZE=0.1
XAGUSD_PIP_SIZE=0.01

# NEXUS Auto Trade API (run with: python run_api.py)
AUTOTRADE_API_HOST=127.0.0.1
AUTOTRADE_API_PORT=8080

# Optional public/Telegram URL for the visual Auto Trade installation guide
AUTOTRADE_GUIDE_VIDEO_URL=

# Optional separate pricing. Set values to enable these plan groups.
VIP_ONLY_30_PRICE=25
VIP_ONLY_90_PRICE=69
VIP_ONLY_180_PRICE=129
AUTO_ADDON_30_PRICE=5
AUTO_ADDON_90_PRICE=14
AUTO_ADDON_180_PRICE=27

# User dashboard: Introduction & Guide videos (optional URL fallback)
GUIDE_INTRO_VIDEO_URL=
GUIDE_PURCHASE_VIDEO_URL=
GUIDE_MT5_VIDEO_URL=
GUIDE_CRYPTO_VIDEO_URL=

# Auto Trade entry protection
AUTOTRADE_DEFAULT_MAX_ENTRY_DEVIATION_PCT=0.20
AUTOTRADE_XAUUSD_MAX_ENTRY_DEVIATION_ABS=5.0

# Auto Trade transient notifications
AUTOTRADE_NOTIFICATION_TTL_SECONDS=8

# Exchange API credentials encryption (Fernet key)
# Generate once: python generate_exchange_key.py
EXCHANGE_CREDENTIALS_KEY=
EXCHANGE_DEFAULT_MARKET_TYPE=swap

# Canonical MT5 tutorial video URL fallback (local file is assets/guides/NEXUS_AutoTrade_MT5_Guide.mp4)
GUIDE_MT5_VIDEO_URL=

# NEXUS v7.1 Pricing / USDT-RIAL
USDT_RIAL_RATE_SOURCE=nobitex
USDT_RIAL_RATE_URL=https://api.nobitex.ir/v3/orderbook/USDTIRT
USDT_RIAL_CACHE_SECONDS=60
RIAL_INVOICE_TTL_MINUTES=15
UPGRADE_PRORATION_ENABLED=true
AUTOTRADE_EXPIRY_MODE=A
# Safety gate: set true only after compiling/replacing the final v0.5.7 EX5.
AUTOTRADE_EX5_RELEASE_ENABLED=false

# Admin-only MT5 bypass (server-side allow-list + token)
# Never place real values in source control or the project ZIP.
NEXUS_ADMIN_MT5_ACCOUNTS=
NEXUS_ADMIN_TOKEN=

# --- NEXUS Agentic Public Channel Content ---
# Keep real API keys only in the VPS .env file. Never commit them to GitHub.
CONTENT_AGENTS_ENABLED=false
CONTENT_DAILY_TIME=12:00
CONTENT_CATCHUP_ENABLED=true
CONTENT_APPROVAL_MODE=true
CONTENT_PROTECT_CONTENT=false

# Editorial gate: category-specific caps are defined in app/content/taxonomy.py.
# Non-urgent content is also limited by this global daily cap.
CONTENT_EDITORIAL_ENABLED=true
CONTENT_MAX_POSTS_PER_DAY=4

CONTENT_AI_PROVIDER=gemini
CONTENT_AI_API_KEY=
CONTENT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CONTENT_TEXT_MODEL=gemini-3.8-flash

# Optional premium hero-image generation. Disabled by default because Gemini
# image generation is a paid API feature. Local NEXUS artwork remains the fallback.
CONTENT_IMAGE_AI_ENABLED=false
CONTENT_IMAGE_MODEL=gemini-3.1-flash-image

CONTENT_FONT_PATH=C:\Windows\Fonts\arial.ttf
CONTENT_FONT_BOLD_PATH=C:\Windows\Fonts\arialbd.ttf
