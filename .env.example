# NEXUS Telegram bot configuration
# Copy to .env and replace every placeholder with a real value.
# NEVER commit .env or production secrets.

BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=123456789
PUBLIC_CHANNEL_ID=-1001234567890
PUBLIC_CHANNEL_URL=https://t.me/your_public_channel
FREE_CHANNEL_ID=-1001234567890
FREE_CHANNEL_URL=https://t.me/your_free_signal_channel
VIP_CHANNEL_ID=-1009876543210
VIP_CHANNEL_URL=https://t.me/your_vip_channel
SUPPORT_USERNAME=@your_support

# Runtime storage
DATABASE_PATH=nexus_bot.db
FSM_DATABASE_PATH=nexus_fsm.db
TIMEZONE=Asia/Tehran

# Payment configuration (placeholders only)
PAYMENT_CARD=0000000000000000
PAYMENT_OWNER=NEXUS
USDT_WALLET=0xYOUR_WALLET
USDT_NETWORK=SET_NETWORK

# Subscription prices. Keep these values synchronized with the plan catalog.
PLAN_30_PRICE=3.000.000 تومان
PLAN_90_PRICE=8.200.000 تومان
PLAN_180_PRICE=14.000.000 تومان
PLAN_30_USDT=SET_PRICE
PLAN_90_USDT=SET_PRICE
PLAN_180_USDT=SET_PRICE

# Reports
REPORTS_ENABLED=true
DAILY_REPORT_TIME=23:59
WEEKLY_REPORT_DAY=FRIDAY
WEEKLY_REPORT_TIME=23:59
REPORT_RECIPIENT_IDS=
CHANNEL_REPORTS_ENABLED=true
CHANNEL_CONTENT_LANGUAGE=fa
REPORT_CATCHUP_ENABLED=false

# Optional AutoTrade channel / API integration
AUTOTRADE_CHANNEL_URL=
AUTOTRADE_API_BASE_URL=http://127.0.0.1:8080
NEXUS_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Broker-specific pip conventions used by result reporting
XAUUSD_PIP_SIZE=0.1
XAGUSD_PIP_SIZE=0.01

# Operational security guidance:
# - Use a unique long admin token and keep it outside Git.
# - Restrict API exposure; do not bind a private control API publicly without TLS/authentication.
# - Rotate Telegram/admin/payment credentials if exposed.
