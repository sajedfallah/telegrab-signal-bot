BOT_TOKEN=PASTE_BOT_TOKEN_HERE
ADMIN_IDS=123456789
PUBLIC_CHANNEL_ID=-1001234567890
PUBLIC_CHANNEL_URL=https://t.me/your_public_channel
FREE_CHANNEL_URL=https://t.me/your_free_signal_channel
# Optional for a public channel; required if the free channel is private
FREE_CHANNEL_ID=
VIP_CHANNEL_ID=-1009876543210
SUPPORT_USERNAME=https://t.me/your_support
PAYMENT_CARD=0000000000000000
PAYMENT_OWNER=NEXUS
TIMEZONE=Asia/Tehran
REMINDER_DAYS=7,3,1
PLAN_30_PRICE=3.000.000 تومان
PLAN_90_PRICE=8.200.000 تومان
PLAN_180_PRICE=14.000.000 تومان
USDT_WALLET=0xYOUR_WALLET
USDT_NETWORK=SET_NETWORK
PLAN_30_USDT=SET_PRICE
PLAN_90_USDT=SET_PRICE
PLAN_180_USDT=SET_PRICE

# Automatic admin reports (Asia/Tehran by default)
REPORTS_ENABLED=true
DAILY_REPORT_TIME=23:59
WEEKLY_REPORT_DAY=FRIDAY
WEEKLY_REPORT_TIME=23:59
# Empty = all ADMIN_IDS
REPORT_RECIPIENT_IDS=
# Send one compact report containing FREE + VIP performance to both signal channels
CHANNEL_REPORTS_ENABLED=true
# Channel flashcards: fa or en
CHANNEL_CONTENT_LANGUAGE=fa
# false prevents old daily/weekly reports from being dumped when the bot restarts
REPORT_CATCHUP_ENABLED=false

# Optional paid Auto-Trade channel; leave empty until configured
AUTOTRADE_CHANNEL_URL=

# Broker-specific Forex pip conventions used in result reports
XAUUSD_PIP_SIZE=0.1
XAGUSD_PIP_SIZE=0.01
